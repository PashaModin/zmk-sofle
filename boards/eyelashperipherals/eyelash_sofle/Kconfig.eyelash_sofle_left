# Extends the BOARD_EYELASH_SOFLE_LEFT symbol that Zephyr generates from
# board.yml. ZMK_BOARD_COMPAT tells ZMK this board is deliberately set up for
# ZMK (settings storage, UF2 bootloader integration); without it the build
# warns that you may have picked a non-ZMK board variant.

config BOARD_EYELASH_SOFLE_LEFT
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT
